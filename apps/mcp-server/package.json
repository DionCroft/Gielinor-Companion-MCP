{
  "name": "@gielinor/mcp-server",
  "version": "1.2.0",
  "description": "Local stdio MCP server for Gielinor Companion MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gielinor-companion-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@gielinor/core": "workspace:*",
    "@gielinor/database": "workspace:*",
    "@gielinor/providers": "workspace:*",
    "@gielinor/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "runescape",
    "runescape-3",
    "quest-planner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DionCroft/Gielinor-Companion-MCP.git",
    "directory": "apps/mcp-server"
  },
  "homepage": "https://github.com/DionCroft/Gielinor-Companion-MCP#readme",
  "bugs": {
    "url": "https://github.com/DionCroft/Gielinor-Companion-MCP/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
