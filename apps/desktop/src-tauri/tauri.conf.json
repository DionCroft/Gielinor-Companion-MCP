{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gielinor Companion",
  "version": "1.2.0",
  "identifier": "io.github.dioncroft.gielinor-companion",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'",
      "freezePrototype": false
    },
    "windows": [
      {
        "title": "Gielinor Companion",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Read-only RuneScape 3 planning companion",
    "longDescription": "A deterministic, local-first RuneScape 3 companion for profiles, quests, levelling, and Grand Exchange analysis.",
    "copyright": "Copyright 2026 Gielinor Companion contributors",
    "externalBin": ["binaries/gielinor-runtime"],
    "resources": ["runtime/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Gielinor Companion",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
