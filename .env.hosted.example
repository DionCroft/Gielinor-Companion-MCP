# Copy to .env.hosted. Never commit the real file.
GIELINOR_ALLOWED_HOSTS=mcp.example.com,127.0.0.1
GIELINOR_ALLOWED_ORIGINS=
GIELINOR_TRUST_PROXY=true
GIELINOR_REQUIRE_HTTPS=true
GIELINOR_ACCOUNT_CREATION_ENABLED=false

# Generate at least 32 random characters and store the real value only in your
# deployment secret manager or untracked .env.hosted file.
GIELINOR_OPERATOR_TOKEN=

GIELINOR_MAX_REQUEST_BYTES=262144
GIELINOR_MAX_BATCH_MESSAGES=4
GIELINOR_REQUESTS_PER_MINUTE=120
GIELINOR_TOOL_CALLS_PER_MINUTE=60
GIELINOR_HOSTED_REQUEST_TIMEOUT_MS=30000
GIELINOR_SHUTDOWN_TIMEOUT_MS=10000

GIELINOR_USER_AGENT=Gielinor-Companion-MCP/0.8.0 (contact: you@example.com)
GIELINOR_HTTP_TIMEOUT_MS=10000
GIELINOR_HTTP_RETRIES=2
