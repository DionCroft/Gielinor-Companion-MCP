{
  "name": "@gielinor/providers",
  "version": "1.2.0",
  "description": "Resilient public-data providers and stable plugin routing for Gielinor Companion.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jagex-hiscores": {
      "types": "./dist/jagex-hiscores.d.ts",
      "import": "./dist/jagex-hiscores.js"
    },
    "./jagex-hiscores-parser": {
      "types": "./dist/jagex-hiscores-parser.d.ts",
      "import": "./dist/jagex-hiscores-parser.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gielinor/core": "workspace:*",
    "@gielinor/shared-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DionCroft/Gielinor-Companion-MCP.git",
    "directory": "packages/providers"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "license": "MIT"
}
